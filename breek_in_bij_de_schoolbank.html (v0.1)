<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Breek in bij de schoolbank - Educatieve Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --neon-green: #22c55e;
            --neon-red: #ef4444;
            --metal-dark: #050608;
            --metal-light: #12141c;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--metal-dark);
            color: #f1f5f9;
            overflow-x: hidden;
            user-select: none;
        }

        .font-tech {
            font-family: 'Share Tech Mono', monospace;
        }

        .safe-container {
            width: 190px;
            height: 190px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--metal-light) 0%, #030406 90%);
            border: 6px solid #1e293b;
            box-shadow: 0 0 35px rgba(0,0,0,0.95), inset 0 0 25px rgba(0,0,0,0.9);
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto;
        }

        .safe-dial {
            width: 125px;
            height: 125px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1e202e 0%, #0b0c10 100%);
            border: 3px dashed #475569;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.8);
            position: absolute;
        }

        .timer-display {
            font-size: 2.1rem;
            color: var(--neon-green);
            text-shadow: 0 0 14px rgba(34, 197, 94, 0.6);
            z-index: 10;
            position: relative;
        }

        .timer-warning {
            color: var(--neon-red);
            text-shadow: 0 0 14px rgba(239, 68, 68, 0.7);
            animation: pulse-fast 0.8s infinite;
        }

        @keyframes pulse-fast {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.06); }
            100% { opacity: 1; transform: scale(1); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-9px); }
            40%, 80% { transform: translateX(9px); }
        }

        .shake-animation {
            animation: shake 0.4s ease-in-out;
        }

        .status-light {
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background-color: #1e293b;
            border: 1px solid #334155;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.7);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .status-light.active {
            background-color: var(--neon-green);
            border-color: #86efac;
            box-shadow: 0 0 15px var(--neon-green), inset 0 1px 3px rgba(255,255,255,0.9);
        }

        .bg-glass {
            background: rgba(13, 15, 23, 0.96);
            backdrop-filter: blur(18px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .scoreboard {
            max-height: 190px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #475569 #0f172a;
        }
        
        .scoreboard::-webkit-scrollbar {
            width: 6px;
        }
        
        .scoreboard::-webkit-scrollbar-track {
            background: #0f172a; 
            border-radius: 4px;
        }
        
        .scoreboard::-webkit-scrollbar-thumb {
            background-color: #475569; 
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-3 sm:p-6">

    <div id="app-container" class="w-full max-w-2xl relative">
        
        <div id="menu-screen" class="bg-glass rounded-3xl p-6 sm:p-8 shadow-2xl text-center">
            <div class="mb-5">
                <span class="text-xs font-bold tracking-widest text-emerald-400 bg-emerald-950 px-3.5 py-1 rounded-full border border-emerald-800/60 uppercase">Educatieve Escape Game</span>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-3 mb-2 tracking-wide font-tech">BREEK IN BIJ DE SCHOOLBANK</h1>
                <p class="text-gray-300 text-sm sm:text-base leading-relaxed">Kraak de kluis binnen 5 minuten door slimme vragen en diverse vakpuzzels op te lossen!</p>
            </div>
            
            <!-- Highscores Box -->
            <div class="mb-5 bg-slate-900/90 p-4 rounded-2xl border border-slate-800 text-left shadow-inner">
                <div class="flex justify-between items-center mb-2 px-1">
                    <h2 class="text-xs font-bold text-gray-300 uppercase tracking-wider flex items-center gap-2">
                        <span>🏆</span> Highscores
                    </h2>
                    <button onclick="clearScores()" class="text-xs text-rose-400 hover:text-rose-300 font-medium transition">Wis scores</button>
                </div>
                <div id="score-list" class="scoreboard space-y-1.5 text-sm text-gray-200 pr-1">
                    <p class="text-gray-400 italic text-center py-3 text-xs">Nog geen scores geregistreerd.</p>
                </div>
            </div>

            <!-- Difficulty Picker -->
            <div class="mb-5 text-left bg-slate-900/90 p-4 sm:p-5 rounded-2xl border border-slate-800">
                <h2 class="text-xs font-bold text-gray-300 uppercase tracking-wider mb-2.5">1. Kies je niveau:</h2>
                <div class="grid grid-cols-3 gap-3">
                    <label class="cursor-pointer">
                        <input type="radio" name="difficulty" value="makkelijk" class="peer hidden" checked>
                        <div class="p-3 text-center rounded-xl border border-slate-700 text-gray-300 font-medium peer-checked:bg-emerald-950 peer-checked:border-emerald-500 peer-checked:text-emerald-300 transition shadow-sm text-sm">
                            Makkelijk
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="difficulty" value="gemiddeld" class="peer hidden">
                        <div class="p-3 text-center rounded-xl border border-slate-700 text-gray-300 font-medium peer-checked:bg-amber-950 peer-checked:border-amber-500 peer-checked:text-amber-300 transition shadow-sm text-sm">
                            Gemiddeld
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="difficulty" value="moeilijk" class="peer hidden">
                        <div class="p-3 text-center rounded-xl border border-slate-700 text-gray-300 font-medium peer-checked:bg-rose-950 peer-checked:border-rose-500 peer-checked:text-rose-300 transition shadow-sm text-sm">
                            Moeilijk
                        </div>
                    </label>
                </div>
            </div>

            <!-- Subjects Picker -->
            <div class="mb-6 text-left bg-slate-900/90 p-4 sm:p-5 rounded-2xl border border-slate-800">
                <div class="flex justify-between items-center mb-2.5">
                    <h2 class="text-xs font-bold text-gray-300 uppercase tracking-wider">2. Selecteer vakken:</h2>
                    <span id="subject-error" class="hidden text-rose-400 text-xs font-semibold animate-pulse">Selecteer minstens 1 vak!</span>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <label class="flex items-center space-x-3 cursor-pointer group p-2 rounded-xl hover:bg-slate-800/60 transition">
                        <input type="checkbox" value="wiskunde" class="subject-cb form-checkbox h-4 w-4 text-indigo-500 rounded focus:ring-indigo-400 bg-slate-800 border-slate-700" checked>
                        <span class="text-gray-200 group-hover:text-white text-sm font-medium transition-colors">📐 Wiskunde & Rekenen</span>
                    </label>
                    <label class="flex items-center space-x-3 cursor-pointer group p-2 rounded-xl hover:bg-slate-800/60 transition">
                        <input type="checkbox" value="geschiedenis" class="subject-cb form-checkbox h-4 w-4 text-indigo-500 rounded focus:ring-indigo-400 bg-slate-800 border-slate-700" checked>
                        <span class="text-gray-200 group-hover:text-white text-sm font-medium transition-colors">🏛️ Geschiedenis</span>
                    </label>
                    <label class="flex items-center space-x-3 cursor-pointer group p-2 rounded-xl hover:bg-slate-800/60 transition">
                        <input type="checkbox" value="aardrijkskunde" class="subject-cb form-checkbox h-4 w-4 text-indigo-500 rounded focus:ring-indigo-400 bg-slate-800 border-slate-700" checked>
                        <span class="text-gray-200 group-hover:text-white text-sm font-medium transition-colors">🌍 Aardrijkskunde</span>
                    </label>
                    <label class="flex items-center space-x-3 cursor-pointer group p-2 rounded-xl hover:bg-slate-800/60 transition">
                        <input type="checkbox" value="wetenschap" class="subject-cb form-checkbox h-4 w-4 text-indigo-500 rounded focus:ring-indigo-400 bg-slate-800 border-slate-700" checked>
                        <span class="text-gray-200 group-hover:text-white text-sm font-medium transition-colors">🔬 Natuurkunde & Wetenschap</span>
                    </label>
                    <label class="flex items-center space-x-3 cursor-pointer group p-2 rounded-xl hover:bg-slate-800/60 transition sm:col-span-2">
                        <input type="checkbox" value="taal" class="subject-cb form-checkbox h-4 w-4 text-indigo-500 rounded focus:ring-indigo-400 bg-slate-800 border-slate-700" checked>
                        <span class="text-gray-200 group-hover:text-white text-sm font-medium transition-colors">📖 Nederlandse Taal & Grammatica</span>
                    </label>
                </div>
            </div>

            <button onclick="startGame()" class="w-full py-4 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-bold rounded-2xl shadow-xl shadow-indigo-600/25 transform transition active:scale-98 text-base tracking-wide">
                START INBRAAKMISSIE 🚀
            </button>
        </div>

        <div id="game-screen" class="hidden flex-col items-center">
            
            <div class="w-full flex justify-between items-center mb-4 px-2">
                <button onclick="quitGame()" class="text-xs sm:text-sm text-gray-300 hover:text-white transition flex items-center gap-1 bg-slate-800/90 px-3 py-1.5 rounded-xl border border-slate-700">← Stoppen</button>
                <div class="text-right">
                    <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">Kluisstatus</p>
                    <p class="text-xs font-tech text-emerald-400 font-semibold">10 Codes Vereist</p>
                </div>
            </div>

            <!-- Safe Visual Dial -->
            <div id="safe-wrapper" class="safe-container mb-5">
                <div id="safe-dial" class="safe-dial"></div>
                <div id="timer-display" class="font-tech timer-display">05:00</div>
            </div>

            <!-- Progress Lights Indicator -->
            <div class="flex justify-center flex-wrap gap-2 mb-5 bg-slate-900/90 px-4 py-3 rounded-2xl border border-slate-800 shadow-inner max-w-md w-full" id="progress-lights">
                <!-- Injected via JS -->
            </div>

            <!-- Question & Puzzle Card -->
            <div class="w-full bg-glass rounded-3xl p-6 sm:p-7 shadow-2xl border-t-2 border-indigo-500">
                <div class="flex justify-between items-center mb-3">
                    <span id="question-subject" class="text-xs font-bold uppercase tracking-wider text-indigo-300 bg-indigo-950 px-3.5 py-1 rounded-full border border-indigo-800/60">Vak</span>
                    <span id="feedback-message" class="text-xs font-bold font-tech opacity-0 transition-opacity duration-300"></span>
                </div>
                <h3 id="question-text" class="text-lg sm:text-xl font-bold text-white mb-5 leading-snug min-h-[50px]">Laden...</h3>
                
                <!-- Dynamic Interactive Workspace -->
                <div id="interactive-content"></div>
            </div>

        </div>

        <div id="result-screen" class="hidden bg-glass rounded-3xl p-6 sm:p-8 shadow-2xl text-center border-2 border-emerald-500/40">
            <h2 id="result-title" class="text-4xl sm:text-5xl font-extrabold mb-3 font-tech text-emerald-400">KLUIS GEKRAAKT! 🎉</h2>
            <p id="result-message" class="text-gray-300 text-sm sm:text-base mb-6 leading-relaxed">Gefeliciteerd! Je hebt alle codes opgelost en de kluis met succes geopend.</p>
            
            <div class="bg-slate-900/90 p-4 sm:p-5 rounded-2xl border border-slate-800 mb-6 grid grid-cols-2 gap-4 text-center">
                <div>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-400 block font-bold">Behaalde Score</span>
                    <span id="stat-score" class="text-2xl sm:text-3xl font-tech text-emerald-400 font-bold">0</span>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-400 block font-bold">Resterende Tijd</span>
                    <span id="stat-time" class="text-2xl sm:text-3xl font-tech text-indigo-400 font-bold">00:00</span>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-400 block font-bold">Gemaakte Fouten</span>
                    <span id="stat-mistakes" class="text-xl sm:text-2xl font-tech text-rose-400 font-bold">0</span>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs uppercase tracking-wider text-gray-400 block font-bold">Niveau</span>
                    <span id="stat-diff" class="text-xl sm:text-2xl font-tech text-amber-400 font-bold capitalize">Makkelijk</span>
                </div>
            </div>

            <button onclick="resetToMenu()" class="w-full py-4 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-bold rounded-2xl shadow-xl shadow-indigo-600/25 transform transition active:scale-98 text-base tracking-wide">
                TERUG NAAR HOOFDMENU 🏠
            </button>
        </div>

    </div>

    <script>
        // Uitgebreide database met unieke vraag- en puzzelsoorten per niveau en vak
        const questionDatabase = [
            // --- WISKUNDE & REKENEN ---
            { type: 'quiz', subject: 'wiskunde', difficulty: 'makkelijk', text: 'Wat is de exacte uitkomst van 45 + 28?', options: ['73', '71', '83', '63'], answer: '73' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'makkelijk', text: 'Hoeveel is 35% van 200?', options: ['70', '60', '75', '80'], answer: '70' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'makkelijk', text: 'Wat is de breuk 3/4 uitgedrukt in een decimaal getal?', options: ['0.75', '0.65', '0.80', '0.50'], answer: '0.75' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'makkelijk', text: 'Wat is de uitkomst van 12 × 8?', options: ['96', '88', '104', '86'], answer: '96' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'makkelijk', text: 'Wat is de wortel van 81?', options: ['9', '8', '7', '11'], answer: '9' },

            { type: 'quiz', subject: 'wiskunde', difficulty: 'gemiddeld', text: 'Wat is de uitkomst van 14 × 13?', options: ['182', '168', '156', '172'], answer: '182' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'gemiddeld', text: 'Los de bewerking op volgens de rekenregels: 120 / (4 + 6) × 2', options: ['24', '12', '60', '48'], answer: '24' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'gemiddeld', text: 'Wat is de omtrek van een cirkel met een straal van 7 cm? (Gebruik π ≈ 3.14)', options: ['43.96 cm', '21.98 cm', '153.86 cm', '28.00 cm'], answer: '43.96 cm' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'gemiddeld', text: 'Wat is 15% van 340?', options: ['51', '45', '55', '48'], answer: '51' },
            {
                type: 'graph_puzzle',
                subject: 'wiskunde',
                difficulty: 'gemiddeld',
                text: 'X-T Grafiek Puzzel: Een voertuig rijdt met een constante snelheid van 15 m/s. Wat is de afgelegde afstand na 4 seconden?',
                targetTime: 4,
                targetDistance: 60,
                correctTolerance: 4
            },

            { type: 'quiz', subject: 'wiskunde', difficulty: 'moeilijk', text: 'Wat is de wortel van 225 plus 15 in het kwadraat?', options: ['240', '230', '150', '225'], answer: '240' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'moeilijk', text: 'Los op voor x als 3x - 7 = 20:', options: ['9', '8', '7', '10'], answer: '9' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'moeilijk', text: 'Wat is de inhoud van een cilinder met straal 3 cm en hoogte 10 cm? (Gebruik π ≈ 3.14)', options: ['282.6 cm³', '188.4 cm³', '94.2 cm³', '314.0 cm³'], answer: '282.6 cm³' },
            { type: 'quiz', subject: 'wiskunde', difficulty: 'moeilijk', text: 'Wat is de waarde van 2 tot de macht 8?', options: ['256', '128', '512', '64'], answer: '256' },
            {
                type: 'graph_puzzle',
                subject: 'wiskunde',
                difficulty: 'moeilijk',
                text: 'Versnelling Puzzel: Een fietser fietst met een constante snelheid van 8 m/s gedurende 6 seconden. Wat is de totale afgelegde afstand in meters?',
                targetTime: 6,
                targetDistance: 48,
                correctTolerance: 3
            },

            // --- GESCHIEDENIS ---
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'makkelijk', text: 'In welk jaar begon de Tachtigjarige Oorlog officieel met de Slag bij Heiligerlee?', options: ['1568', '1648', '1515', '1602'], answer: '1568' },
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'makkelijk', text: 'Wie schreef het wereldberoemde dagboek ondergedoken in het Achterhuis te Amsterdam?', options: ['Anne Frank', 'Aletta Jacobs', 'Coline Grüter', 'Johanna Westerdijk'], answer: 'Anne Frank' },
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'makkelijk', text: 'Welke ontdekkingsreiziger ontdekte in 1492 per ongeluk Amerika?', options: ['Christoffel Columbus', 'Vasco da Gama', 'Magellaan', 'Amerigo Vespucci'], answer: 'Christoffel Columbus' },
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'makkelijk', text: 'In welke eeuw vonden de Gouden Eeuw en de schilderijen van Rembrandt plaats?', options: ['17e eeuw', '16e eeuw', '18e eeuw', '15e eeuw'], answer: '17e eeuw' },

            { type: 'quiz', subject: 'geschiedenis', difficulty: 'gemiddeld', text: 'In welk jaar werd de Republiek der Verenigde Nederlanden erkend bij de Vrede van Münster?', options: ['1648', '1588', '1795', '1813'], answer: '1648' },
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'gemiddeld', text: 'Welke Franse keizer kroonde zichzelf in 1804 en heerste over een groot deel van Europa?', options: ['Napoleon Bonaparte', 'Lodewijk XIV', 'Karel de Grote', 'Robespierre'], answer: 'Napoleon Bonaparte' },
            {
                type: 'timeline_puzzle',
                subject: 'geschiedenis',
                difficulty: 'gemiddeld',
                text: 'Historisch Tijdvak: Koppel het juiste jaartal aan elke historische gebeurtenis.',
