                    { event: 'Oprichting van de VOC', year: '1602' },
                    { event: 'Begin Tachtigjarige Oorlog', year: '1568' },
                    { event: 'De Watersnoodramp', year: '1953' }
                ]
            },
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'gemiddeld', text: 'Welk verdrag maakte in 1919 een officieel einde aan de Eerste Wereldoorlog?', options: ['Verdrag van Versailles', 'Verdrag van Wenen', 'Vrede van Utrecht', 'Verdrag van Parijs'], answer: 'Verdrag van Versailles' },

            { type: 'quiz', subject: 'geschiedenis', difficulty: 'moeilijk', text: 'In welk jaar viel de Berlijnse Muur, wat het einde van de Koude Oorlog inluidde?', options: ['1989', '1991', '1987', '1990'], answer: '1989' },
            { type: 'quiz', subject: 'geschiedenis', difficulty: 'moeilijk', text: 'Tijdens welke eeuw vond de Franse Revolutie plaats?', options: ['18e eeuw (1789)', '17e eeuw (1688)', '19e eeuw (1815)', '16e eeuw (1585)'], answer: '18e eeuw (1789)' },
            {
                type: 'timeline_puzzle',
                subject: 'geschiedenis',
                difficulty: 'moeilijk',
                text: 'Wereldgeschiedenis Tijdlijn: Koppel de juiste historische gebeurtenis aan het juiste jaartal.',
                events: [
                    { event: 'Eerste landing op de Maan', year: '1969' },
                    { event: 'Begin Eerste Wereldoorlog', year: '1914' },
                    { event: 'Val Romeinse Rijk (Westen)', year: '476' }
                ]
            },

            // --- AARDRIJKSKUNDE ---
            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'makkelijk', text: 'Wat is de officiële hoofdstad van Canada?', options: ['Ottawa', 'Toronto', 'Vancouver', 'Montreal'], answer: 'Ottawa' },
            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'makkelijk', text: 'Welke oceaan bevindt zich ten oosten van Afrika en ten westen van Australië?', options: ['Indische Oceaan', 'Atlantische Oceaan', 'Stille Oceaan', 'Noordelijke IJszee'], answer: 'Indische Oceaan' },
            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'makkelijk', text: 'Welk land heeft de meeste inwoners ter wereld?', options: ['China / India', 'Verenigde Staten', 'Brazilië', 'Rusland'], answer: 'China / India' },

            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'gemiddeld', text: 'Wat is het grootste land ter wereld gemeten naar landoppervlakte?', options: ['Rusland', 'Canada', 'China', 'Verenigde Staten'], answer: 'Rusland' },
            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'gemiddeld', text: 'Door welke continenten loopt de evenaar NIET?', options: ['Europa', 'Afrika', 'Zuid-Amerika', 'Azië'], answer: 'Europa' },
            {
                type: 'match_puzzle',
                subject: 'aardrijkskunde',
                difficulty: 'gemiddeld',
                text: 'Geografie Koppelopdracht I: Koppel elk land aan de juiste hoofdstad.',
                pairs: [
                    { item: 'Frankrijk', match: 'Parijs' },
                    { item: 'Italië', match: 'Rome' },
                    { item: 'Spanje', match: 'Madrid' }
                ]
            },

            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'moeilijk', text: 'Welke rivier is de langste rivier ter wereld?', options: ['Nijl', 'Amazone', 'Yangtze', 'Mississippi'], answer: 'Nijl' },
            {
                type: 'match_puzzle',
                subject: 'aardrijkskunde',
                difficulty: 'moeilijk',
                text: 'Geografie Koppelopdracht II: Koppel elk land aan de juiste hoofdstad.',
                pairs: [
                    { item: 'Australië', match: 'Canberra' },
                    { item: 'Japan', match: 'Tokio' },
                    { item: 'Brazilië', match: 'Brasilia' }
                ]
            },
            { type: 'quiz', subject: 'aardrijkskunde', difficulty: 'moeilijk', text: 'Welke woestijn is de droogste niet-polaire woestijn op aarde, gelegen in Zuid-Amerika?', options: ['Atacama', 'Sahara', 'Gobi', 'Kalahari'], answer: 'Atacama' },

