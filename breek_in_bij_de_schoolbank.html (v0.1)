            questionSubject.textContent = `${emojis[currentQuestion.subject] || '🧩'} ${currentQuestion.subject.toUpperCase()} (${currentQuestion.difficulty.toUpperCase()})`;
            questionText.textContent = currentQuestion.text;

            interactiveContent.innerHTML = '';

            if (currentQuestion.type === 'quiz' || !currentQuestion.type) {
                renderQuizAnswers();
            } else if (currentQuestion.type === 'circuit_puzzle') {
                renderCircuitPuzzle();
            } else if (currentQuestion.type === 'graph_puzzle') {
