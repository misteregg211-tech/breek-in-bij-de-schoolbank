        function startGame() {
            const checkboxes = document.querySelectorAll('.subject-cb:checked');
            if (checkboxes.length === 0) {
                document.getElementById('subject-error').classList.remove('hidden');
                return;
            }
            document.getElementById('subject-error').classList.add('hidden');

            const selectedSubjects = Array.from(checkboxes).map(cb => cb.value);
            currentDifficulty = document.querySelector('input[name="difficulty"]:checked').value;
            
            // Filter vragen op geselecteerde vakken en gekozen niveau
            let filtered = questionDatabase.filter(q => 
                selectedSubjects.includes(q.subject) && q.difficulty === currentDifficulty
            );
            
            if (filtered.length < requiredCodes) {
                let fallback = questionDatabase.filter(q => selectedSubjects.includes(q.subject) && q.difficulty !== currentDifficulty);
                shuffleArray(fallback);
                filtered = [...filtered, ...fallback];
            }
            
            shuffleArray(filtered);
            
            activeQuestions = filtered.slice(0, requiredCodes);
            if (activeQuestions.length < requiredCodes) {
                while(activeQuestions.length < requiredCodes && filtered.length > 0) {
                    activeQuestions.push(filtered[Math.floor(Math.random() * filtered.length)]);
                }
            }

            gameTime = 300;
            codesCracked = 0;
            mistakes = 0;
            dialRotation = 0;
            safeDial.style.transform = `rotate(0deg)`;
            
            setupProgressLights();
            showScreen('game');
            updateTimerDisplay();
            
            clearInterval(timerInterval);
            timerInterval = setInterval(gameTick, 1000);

            loadNextQuestion();
        }

        function quitGame() {
            clearInterval(timerInterval);
            resetToMenu();
        }

        function resetToMenu() {
            showScreen('menu');
        }

        function gameTick() {
            if (gameTime > 0) {
                gameTime--;
                updateTimerDisplay();
                if (gameTime <= 30) {
                    timerDisplay.classList.add('timer-warning');
                } else {
                    timerDisplay.classList.remove('timer-warning');
                }
            } else {
                endGame(false);
            }
        }

        function updateTimerDisplay() {
            const minutes = Math.floor(Math.max(gameTime, 0) / 60);
            const seconds = Math.max(gameTime, 0) % 60;
            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function setupProgressLights() {
            progressLights.innerHTML = '';
            for (let i = 0; i < requiredCodes; i++) {
                const light = document.createElement('div');
                light.className = 'status-light';
                light.id = `light-${i}`;
                progressLights.appendChild(light);
            }
        }

        function loadNextQuestion() {
            if (activeQuestions.length === 0) {
                endGame(true);
