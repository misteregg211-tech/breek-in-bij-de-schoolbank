            function renderSentence() {
                sentencePreview.innerHTML = '';
                if (currentSelected.length === 0) {
                    sentencePreview.innerHTML = '<span class="text-gray-500 italic text-xs">Klik hierboven op de woorden om de zin te bouwen...</span>';
                    return;
                }
                currentSelected.forEach((word) => {
                    const tag = document.createElement('span');
                    tag.className = 'px-3 py-1 bg-indigo-600/90 text-white rounded-xl text-xs sm:text-sm font-bold shadow flex items-center gap-1.5';
                    tag.innerHTML = `<span>${word}</span>`;
                    sentencePreview.appendChild(tag);
                });
            }

            const resetBtn = document.createElement('button');
            resetBtn.className = 'text-xs text-gray-400 hover:text-white underline block mx-auto transition';
            resetBtn.textContent = 'Opnieuw beginnen';
            resetBtn.onclick = () => {
                interactiveContent.innerHTML = '';
                renderOrderPuzzle();
            };

            const checkBtn = document.createElement('button');
            checkBtn.className = 'w-full py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl shadow-lg transition text-base';
            checkBtn.textContent = 'Controleer Zinsvolgorde 📝';
            checkBtn.onclick = () => {
                let isCorrect = currentSelected.length === currentQuestion.correctOrder.length &&
                    currentSelected.every((val, index) => val === currentQuestion.correctOrder[index]);
                handleAnswerResult(isCorrect, checkBtn);
            };

            container.appendChild(poolBox);
            container.appendChild(sentencePreview);
            container.appendChild(resetBtn);
            container.appendChild(checkBtn);
            interactiveContent.appendChild(container);
            renderSentence();
        }

        // --- VALIDATIE & VOORTGANG ---

        function handleAnswerResult(isCorrect, buttonElement) {
            if (isAnimating) return;
            isAnimating = true;

            if (isCorrect) {
                if(buttonElement && buttonElement.tagName === 'BUTTON') {
                    buttonElement.classList.replace('bg-indigo-600', 'bg-emerald-600');
                }
                showFeedback("✓ CORRECTE CODE", "text-emerald-400");
                
                dialRotation += 36;
                safeDial.style.transform = `rotate(${dialRotation}deg)`;
                
                document.getElementById(`light-${codesCracked}`).classList.add('active');
                codesCracked++;

                setTimeout(() => {
                    isAnimating = false;
                    if (codesCracked >= requiredCodes) {
                        endGame(true);
                    } else {
                        loadNextQuestion();
                    }
                }, 750);

            } else {
                mistakes++;
                if(buttonElement && buttonElement.tagName === 'BUTTON') {
                    buttonElement.classList.replace('bg-indigo-600', 'bg-rose-600');
                }
                showFeedback("✕ ONJUIST (-15s)", "text-rose-400");
                
                safeWrapper.classList.add('shake-animation');
                
                gameTime -= 15;
                if (gameTime < 0) gameTime = 0;
                updateTimerDisplay();

                setTimeout(() => {
                    safeWrapper.classList.remove('shake-animation');
                    isAnimating = false;
                    if (gameTime === 0) {
                        endGame(false);
                    } else {
                        loadNextQuestion();
                    }
                }, 900);
            }
        }

        function showFeedback(text, colorClass) {
            feedbackMessage.textContent = text;
            feedbackMessage.className = `text-xs font-bold font-tech transition-opacity duration-300 ${colorClass}`;
            feedbackMessage.style.opacity = 1;
            
            setTimeout(() => {
                feedbackMessage.style.opacity = 0;
            }, 800);
        }

        function endGame(won) {
            clearInterval(timerInterval);
            timerDisplay.classList.remove('timer-warning');

            const title = document.getElementById('result-title');
            const message = document.getElementById('result-message');
            const resultScreen = document.getElementById('result-screen');

            document.getElementById('stat-time').textContent = timerDisplay.textContent;
            document.getElementById('stat-mistakes').textContent = mistakes;
            document.getElementById('stat-diff').textContent = currentDifficulty;

            let score = 0;

            if (won) {
                title.textContent = "KLUIS GEKRAAKT! 🎉";
                title.className = "text-4xl sm:text-5xl font-extrabold mb-3 font-tech text-emerald-400";
                message.textContent = "Fantastisch! Je hebt alle vragen en puzzels opgelost en de kluis geopend.";
                resultScreen.style.borderColor = "rgba(34, 197, 94, 0.4)";
                
                let diffMultiplier = currentDifficulty === 'makkelijk' ? 1 : (currentDifficulty === 'gemiddeld' ? 1.5 : 2);
                score = Math.floor(1000 + (gameTime * 2 * diffMultiplier) - (mistakes * 40));
                if (score < 0) score = 0;
                
                saveScore(score);
            } else {
                title.textContent = "ALARM GEACTIVEERD! 🚨";
                title.className = "text-4xl sm:text-5xl font-extrabold mb-3 font-tech text-rose-500";
                message.textContent = "De tijd is verstreken of de beveiliging heeft ingegrepen. Probeer het opnieuw!";
                resultScreen.style.borderColor = "rgba(239, 68, 68, 0.4)";
                score = 0;
            }
            
            document.getElementById('stat-score').textContent = score;
            showScreen('result');
        }
        
        function saveScore(score) {
            const date = new Date();
            const dateStr = `${date.getDate()}/${date.getMonth()+1} ${date.getHours()}:${date.getMinutes().toString().padStart(2, '0')}`;
            
            highscores.push({
                score: score,
                difficulty: currentDifficulty,
                date: dateStr
            });
            
            highscores.sort((a, b) => b.score - a.score);
            if (highscores.length > 8) highscores = highscores.slice(0, 8);
            
            localStorage.setItem('kluiskrakerScoresNewV7', JSON.stringify(highscores));
        }
        
        function renderScores() {
            const list = document.getElementById('score-list');
            list.innerHTML = '';
            
            if (highscores.length === 0) {
                list.innerHTML = '<p class="text-gray-400 italic text-center py-3 text-xs">Nog geen scores geregistreerd.</p>';
                return;
            }
            
            highscores.forEach((entry, index) => {
                const item = document.createElement('div');
                item.className = 'flex justify-between items-center p-2.5 bg-slate-950/80 rounded-xl border border-slate-800/80';
                
                let medal = '';
                if (index === 0) medal = '🥇';
                else if (index === 1) medal = '🥈';
                else if (index === 2) medal = '🥉';
                else medal = `<span class="w-5 inline-block text-center text-gray-400">${index+1}.</span>`;
                
                item.innerHTML = `
                    <div class="flex items-center space-x-2.5">
                        <span class="text-sm">${medal}</span>
                        <span class="text-xs text-gray-300 capitalize font-medium w-16">${entry.difficulty}</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <span class="text-[11px] text-gray-400">${entry.date}</span>
                        <span class="font-tech text-emerald-400 font-bold text-sm">${entry.score}</span>
                    </div>
                `;
                list.appendChild(item);
            });
        }
        
        function clearScores() {
            highscores = [];
            localStorage.removeItem('kluiskrakerScoresNewV7');
            renderScores();
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }
    </script>
</body>
